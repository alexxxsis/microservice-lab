          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP-код 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
