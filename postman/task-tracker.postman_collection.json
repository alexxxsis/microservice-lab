          "name": "07 · Список задач с фильтрами (GET)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/tasks?status=todo&priority=high&limit=5&offset=0",
              "host": [
